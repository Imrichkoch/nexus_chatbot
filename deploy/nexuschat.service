[Unit]
Description=NexusChat private AI workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexuschat
Group=nexuschat
WorkingDirectory=/opt/nexuschat
EnvironmentFile=/etc/nexuschat.env
ExecStart=/opt/nexuschat/.venv/bin/uvicorn nexus.app:app --host 127.0.0.1 --port 8300 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=4
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nexuschat/data
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target

