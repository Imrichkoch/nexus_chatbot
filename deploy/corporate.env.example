# Copy outside the repository and replace the domain/provider values.
NEXUS_ALLOWED_HOSTS=chat.example.com,127.0.0.1,localhost
NEXUS_BASE_PATH=
NEXUS_SECURE_COOKIES=1
NEXUS_REGISTRATION_ENABLED=0
NEXUS_SESSION_HOURS=8
NEXUS_MAX_CONCURRENT_CHATS=4
NEXUS_DATABASE=/opt/nexuschat/data/nexus.sqlite3
NEXUS_SYNTHETIC_DATABASE=/opt/nexuschat/data/synthetic-business.sqlite3
NEXUS_INFRA_SNAPSHOT=/opt/nexuschat/data/infra-snapshot.json
NEXUS_INFRA_CONNECTION_PATH=/opt/nexuschat/data/infra-connections.json
NEXUS_INFRA_SSH_KEY_ROOT=/opt/nexuschat/data/infra-ssh-keys
NEXUS_INFRA_KNOWN_HOSTS=/opt/nexuschat/data/infra-known-hosts
NEXUS_LDAP_SECRET_PATH=/opt/nexuschat/data/ldap-bind-password
NEXUS_DB_CONNECTION_PATH=/opt/nexuschat/data/database-connection.json
NEXUS_EXTERNAL_SQLITE_ROOT=/opt/nexuschat/data/external-databases
NEXUS_DB_ALLOW_INSECURE=0
# NEXUS_DB_CA_FILE=/etc/nexuschat/database-ca.pem
NEXUS_RAG_MAX_DOCUMENTS=1000
NEXUS_RAG_MAX_CHARACTERS=200000000
NEXUS_TLS_HOST=chat.example.com
NEXUS_TLS_ADDRESS=127.0.0.1
OPENAI_BASE_URL=https://approved-provider.example.com/v1
OPENAI_API_KEY=replace-through-your-secret-manager
NEXUS_DEFAULT_MODEL=replace-with-approved-model-id
# Enable only if required. Mount the PEM file read-only in containers.
# NEXUS_LDAP_CA_FILE=/etc/nexuschat/corporate-ca.pem
# Trust only the actual proxy IP/CIDR. Never use '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
