# OpenAI-compatible provider
OPENAI_API_KEY=replace-me
# Leave empty for the OpenAI Responses API. Set an OpenAI-compatible URL when needed.
OPENAI_BASE_URL=

# Application storage
NEXUS_DATABASE=./data/nexus.sqlite3
NEXUS_SYNTHETIC_DATABASE=./data/synthetic-business.sqlite3
NEXUS_INFRA_SNAPSHOT=./data/infra-snapshot.json
NEXUS_LDAP_SECRET_PATH=./data/ldap-bind-password

# Model routing
NEXUS_DEFAULT_MODEL=gpt-5.6-terra
NEXUS_INFRA_MODEL=gpt-5.6-terra
NEXUS_DATA_MODEL=gpt-5.6-terra

# Set to 1 behind HTTPS in production. Use 0 for local HTTP development.
NEXUS_SECURE_COOKIES=0

# URL prefix stripped by your reverse proxy; blank serves at the domain root.
NEXUS_BASE_PATH=
NEXUS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
NEXUS_REGISTRATION_ENABLED=1
NEXUS_SESSION_HOURS=8
NEXUS_MAX_CONCURRENT_CHATS=4
NEXUS_DB_CONNECTION_PATH=/opt/nexuschat/data/database-connection.json
NEXUS_EXTERNAL_SQLITE_ROOT=/opt/nexuschat/data/external-databases
# Optional corporate PEM CA for PostgreSQL, MySQL/MariaDB and Oracle.
# NEXUS_DB_CA_FILE=/etc/nexuschat/database-ca.pem
# Do not enable plaintext database connections outside an isolated test environment.
NEXUS_DB_ALLOW_INSECURE=0
NEXUS_RAG_MAX_DOCUMENTS=1000
NEXUS_RAG_MAX_CHARACTERS=200000000
# Optional PEM corporate CA bundle, readable by the service.
# NEXUS_LDAP_CA_FILE=/etc/nexuschat/corporate-ca.pem
NEXUS_TLS_HOST=localhost
NEXUS_TLS_ADDRESS=127.0.0.1

