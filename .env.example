# OpenAI-compatible provider
OPENAI_API_KEY=replace-me
# Leave empty for the OpenAI Responses API. Set an OpenAI-compatible URL when needed.
OPENAI_BASE_URL=

# Application storage
NEXUS_DATABASE=./data/nexus.sqlite3
NEXUS_SYNTHETIC_DATABASE=./data/synthetic-business.sqlite3
NEXUS_INFRA_SNAPSHOT=./data/infra-snapshot.json

# Model routing
NEXUS_DEFAULT_MODEL=gpt-5.6-terra
NEXUS_INFRA_MODEL=gpt-5.6-terra
NEXUS_DATA_MODEL=gpt-5.6-terra

# Set to 1 behind HTTPS in production. Use 0 for local HTTP development.
NEXUS_SECURE_COOKIES=0

